            "$ref": "#/components/schemas/EstadoIa"
          },
          "clasificacionProvisional": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClasificacionResumen"
              },
              {
                "type": "null"
              }
            ]
          },
          "vencimiento": {
            "$ref": "#/components/schemas/Vencimiento"
          },
          "posiblesDuplicados": {
