        "type": "string",
        "enum": [
          "REGISTRAR",
          "CLASIFICAR_REGLAS",
          "CALCULAR_VENCIMIENTO",
          "CLASIFICAR_IA",
          "SUGERENCIA_IA_NO_APLICADA",
          "IA_FALLIDA",
          "IA_OMITIDA",
          "REINTENTO_IA"
        ],
        "title": "AccionAuditoria",
        "description": "Acciones de auditoría de la entrega (contexto.md 4.12). La columna no tiene CHECK."
      },
      "Canal": {
        "type": "string",
        "enum": [
          "DIME",
          "CARTA",
          "CORREO",
          "WEB",
          "VERBAL",
          "BUZON",
          "APLICATIVO_EPS"
        ],
        "title": "Canal",
        "description": "Medio por el que llegó la PQRS."
      },
      "ClasificacionResumen": {
        "properties": {
          "origen": {
            "$ref": "#/components/schemas/OrigenClasificacion"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoPqrs"
          },
          "atributo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Referencia"
              },
              {
                "type": "null"
              }
            ]
          },
          "area": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Referencia"
              },
              {
                "type": "null"
              }
            ]
          },
          "nivelRiesgo": {
            "$ref": "#/components/schemas/NivelRiesgo"
          },
          "confianza": {
            "type": "number",
            "title": "Confianza"
          },
          "resumen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resumen"
          },
          "requiereRevision": {
            "type": "boolean",
            "title": "Requiererevision"
          },
          "modelo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modelo"
          },
          "versionInstrucciones": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
