# Copia este archivo como .env y completa los valores vacíos.
# .env nunca se sube al repositorio: está en .gitignore.

# --- PostgreSQL (servicio db de docker-compose.yml) ---
POSTGRES_DB=radica
POSTGRES_USER=radica
# Sin los caracteres @ : / ? # porque también va dentro de RADICA_DB_URL. Generar con:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Conexión de la aplicación, Alembic y las pruebas ---
# Desde el equipo anfitrión el contenedor se publica en 127.0.0.1:5433:
#   postgresql+psycopg://radica:<contraseña>@127.0.0.1:5433/radica
# Usar 127.0.0.1 y no localhost: en Windows, localhost prueba primero ::1, donde
# el contenedor no escucha, y cada conexión espera hasta agotar el tiempo.
RADICA_DB_URL=

# --- Llaves: 32 bytes en base64 (aún no se usan). Generar cada una con:
#   py -3.12 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
RADICA_LLAVE_CIFRADO=
RADICA_LLAVE_HMAC=

# --- Proveedor de IA (aún no se usa): claude o ninguno ---
IA_PROVIDER=ninguno
IA_MODEL=claude-haiku-5-5
IA_API_KEY=
IA_TIMEOUT_S=15

# --- Umbrales ---
RADICA_UMBRAL_CONFIANZA=0.75
RADICA_UMBRAL_AMARILLO=0.5