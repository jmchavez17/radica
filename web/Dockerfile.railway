# Interfaz web para Railway (issue #20). Las mismas etapas que web/Dockerfile, que sigue
# siendo el de Compose. Railway construye desde la raíz del repositorio y no pasa el
# contexto «contrato»: aquí el OpenAPI de la prueba del contrato se copia de docs/api.
# Su .dockerignore es web/Dockerfile.railway.dockerignore (BuildKit lo prefiere al de la
# raíz, que deja fuera web/ y docs/). Para construirlo en local, desde la raíz:
#   docker build -f web/Dockerfile.railway .
FROM node:24.22.2-alpine3.24 AS dependencias

WORKDIR /web
COPY web/package.json web/package-lock.json web/.npmrc ./
RUN npm ci

# La imagen no se construye si falla una prueba.
FROM dependencias AS pruebas
COPY docs/api/openapi-implementada.json /docs/api/openapi-implementada.json
COPY web/ .
RUN npm test

FROM pruebas AS construccion
RUN npm run build

# Corre como el usuario nginx (101) y escucha en el 8080. nginx.conf es una plantilla (ver
# web/Dockerfile). Sin valores por defecto: si faltan RADICA_RESOLVER o RADICA_API_URL en
# el servicio de Railway, nginx no arranca en vez de apuntar a la red de Compose.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine3.24
ENV NGINX_ENVSUBST_FILTER="^RADICA_" \
    NGINX_ENVSUBST_OUTPUT_DIR="/tmp"
COPY web/nginx.conf /etc/nginx/templates/radica.conf.template
RUN echo "include /tmp/radica.conf;" > /etc/nginx/conf.d/default.conf
COPY --from=construccion /web/dist /usr/share/nginx/html
EXPOSE 8080
