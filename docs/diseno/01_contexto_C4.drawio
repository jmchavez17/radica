<mxfile host="Electron" agent="Radica" version="24.0.0"><diagram id="Contexto_C4_nivel_1" name="Contexto C4 nivel 1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:22px"&gt;Radica · Diagrama de contexto del sistema (C4, nivel 1)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#555"&gt;Entrega 2 · Módulo 2 · Arquitectura y diseño de aplicaciones con IA · versión 1.1, 31 de octubre de 2026&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c2" value="PERSONAS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=center;fontStyle=1;fontColor=#555555;fontSize=13;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="320" height="740" as="geometry"/></mxCell><mxCell id="c3" value="SISTEMAS EXTERNOS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=center;fontStyle=1;fontColor=#555555;fontSize=13;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="82" width="320" height="800" as="geometry"/></mxCell><mxCell id="c4" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Coordinador(a) de servicio al cliente&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Persona]&lt;/div&gt;&lt;div style="margin-top:4px"&gt;&lt;font style="font-size:12px"&gt;Supervisa vencimientos y carga;&lt;br&gt;administra la configuración&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="114" width="280" height="190" as="geometry"/></mxCell><mxCell id="c5" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Funcionario de atención al usuario&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Persona]&lt;/div&gt;&lt;div style="margin-top:4px"&gt;&lt;font style="font-size:12px"&gt;Auxiliar o analista: registra,&lt;br&gt;revisa, asigna y aprueba&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="280" height="190" as="geometry"/></mxCell><mxCell id="c6" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Área responsable&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Persona]&lt;/div&gt;&lt;div style="margin-top:4px"&gt;&lt;font style="font-size:12px"&gt;Asistencial, citas, autorizaciones&lt;br&gt;o facturación: aporta la&lt;br&gt;información de la respuesta&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="606" width="280" height="190" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;&lt;font style="font-size:26px"&gt;Radica&lt;/font&gt;&lt;/b&gt;&lt;div style="margin-top:4px"&gt;[Sistema de software]&lt;/div&gt;&lt;div style="margin-top:12px"&gt;&lt;font style="font-size:12.5px"&gt;Asistente de gestión de PQRS: registra, clasifica con apoyo de IA, calcula el vencimiento con reglas, asigna el área, alerta antes del vencimiento y propone borradores que aprueba una persona&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;metaEdit=1;resizable=1;fontSize=12;fontFamily=Helvetica;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="640" y="355" width="420" height="240" as="geometry"/></mxCell><mxCell id="c8" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Proveedor de modelo de lenguaje&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo · API]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:12px"&gt;Claude Haiku 5.5 (Anthropic); alterno:&lt;br&gt;Gemini 3.1 Flash-Lite (Google). Planes&lt;br&gt;sin uso de los datos para entrenar&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;metaEdit=1;resizable=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="114" width="280" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo · Base de datos]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:12px"&gt;PQRS, configuración e historial;&lt;br&gt;datos personales cifrados&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;strokeColor=#736782;metaEdit=1;resizable=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="310" width="280" height="150" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Hoja de seguimiento de la oficina&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo · Drive]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:12px"&gt;Respaldo manual que hoy se&lt;br&gt;presenta en las auditorías de calidad&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;metaEdit=1;resizable=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="510" width="280" height="120" as="geometry"/></mxCell><mxCell id="c11" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Servicio de correo institucional&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo · SMTP]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:12px"&gt;Entrega las notificaciones&lt;br&gt;a las áreas&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;metaEdit=1;resizable=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="730" width="280" height="120" as="geometry"/></mxCell><mxCell id="e12" value="&lt;b&gt;Consulta vencimientos, carga&lt;br&gt;y temas; configura términos,&lt;br&gt;festivos, áreas y atributos&lt;/b&gt;&lt;br&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.716;exitDx=0;exitDy=0;entryX=0;entryY=0.1875;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" x="-0.35" as="geometry"><Array as="points"><mxPoint x="585" y="250"/><mxPoint x="585" y="400"/></Array><mxPoint x="-21" y="-62" as="offset"/></mxGeometry></mxCell><mxCell id="e13" value="&lt;b&gt;Registra o importa PQRS;&lt;br&gt;revisa y corrige la clasificación;&lt;br&gt;aprueba borradores&lt;/b&gt;&lt;br&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.658;exitDx=0;exitDy=0;entryX=0;entryY=0.479;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-42" as="offset"/></mxGeometry></mxCell><mxCell id="e14" value="&lt;b&gt;Muestra la bandeja&lt;br&gt;con semáforo y alertas&lt;br&gt;de riesgo vital&lt;/b&gt;&lt;br&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.6875;exitDx=0;exitDy=0;entryX=1;entryY=0.921;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="-74" y="44" as="offset"/></mxGeometry></mxCell><mxCell id="e15" value="&lt;b&gt;Envía la información&lt;br&gt;para la respuesta&lt;/b&gt;&lt;br&gt;&lt;b&gt;[correo; fuera de Radica]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="16" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e16" value="&lt;b&gt;Envía texto enmascarado&lt;br&gt;e instrucciones; recibe tipo,&lt;br&gt;atributo, área, riesgo,&lt;br&gt;resumen o borrador&lt;/b&gt;&lt;br&gt;&lt;b&gt;[HTTPS · JSON]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.857;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" x="-0.62" as="geometry"><Array as="points"><mxPoint x="1000" y="174"/></Array><mxPoint x="18" y="-50" as="offset"/></mxGeometry></mxCell><mxCell id="e17" value="&lt;b&gt;Lee y guarda PQRS,&lt;br&gt;configuración e historial&lt;/b&gt;&lt;br&gt;&lt;b&gt;[conexión cifrada]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;startArrow=blockThin;startFill=1;startSize=12;exitX=1;exitY=0.1875;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-32" as="offset"/></mxGeometry></mxCell><mxCell id="e18" value="&lt;b&gt;Reporte semaforizado&lt;br&gt;para auditorías&lt;/b&gt;&lt;br&gt;&lt;b&gt;[CSV, descarga manual]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;dashPattern=8 4;exitX=1;exitY=0.896;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-34" as="offset"/></mxGeometry></mxCell><mxCell id="e19" value="&lt;b&gt;Envía asignaciones y&lt;br&gt;recordatorios de&lt;br&gt;vencimiento&lt;/b&gt;&lt;br&gt;&lt;b&gt;[SMTP]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.905;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.292;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="1020" y="765"/></Array><mxPoint x="18" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="e20" value="&lt;b&gt;Entrega las notificaciones [correo]&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=12;fontColor=#333333;strokeWidth=1.5;endFill=1;strokeColor=#707070;metaEdit=1;endSize=12;jumpStyle=arc;jumpSize=12;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.833;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" x="0.0" as="geometry"><Array as="points"><mxPoint x="200" y="830"/></Array><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Convenciones.&lt;/b&gt; Línea continua: interacción con Radica. Línea punteada: intercambio fuera de Radica o mediante archivo. Radica es una herramienta paralela a los registros actuales de la IPS.&lt;br&gt;Las PQRS llegan por canales fuera de Radica (DIME, carta, correo, web, verbal o aplicativo de la EPS) y el funcionario las registra o importa." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;align=left;spacingLeft=10;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="894" width="1580" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>