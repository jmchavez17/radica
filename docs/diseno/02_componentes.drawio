ed=1;html=1;strokeColor=#555555;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="" style="endArrow=block;endFill=0;endSize=11;dashed=1;html=1;strokeColor=#555555;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e72" value="" style="endArrow=block;endFill=0;endSize=11;dashed=1;html=1;strokeColor=#555555;strokeWidth=1.2;rounded=0;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e73" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c44" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e74" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c46" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e75" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c47" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e76" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c50" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e77" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c51" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;Raíz de composición&lt;/b&gt; (main.py) · inyección de dependencias por constructor. Lee IA_PROVIDER = claude | gemini | palabras_clave, IA_MODEL, IA_TIMEOUT_S = 15 e IA_MAX_REINTENTOS = 2, y crea los adaptadores. Las claves (IA_API_KEY, DB_URL, SMTP) llegan por variables de entorno o un gestor de secretos; nunca están en el código ni en el frontend. Es el único punto que conoce las clases concretas." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fillColor=#FDF6E3;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="760" y="985" width="850" height="80" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Convenciones.&lt;/b&gt; Flecha continua: llamada o dependencia. Flecha punteada con triángulo vacío: «implementa» (el adaptador implementa el puerto). Regla de dependencias: el código apunta hacia el núcleo; el dominio no conoce la base de datos, el proveedor de IA ni el framework web." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="905" width="310" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>