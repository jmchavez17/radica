meta {
  name: Bandeja en rojo
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/pqrs?semaforo=ROJO&pagina=1&tamano=20
  body: none
  auth: none
}

params:query {
  semaforo: ROJO
  pagina: 1
  tamano: 20
}

assert {
  res.status: eq 200
  res.body.total: gte 1
}

tests {
  test("todos los elementos están en rojo", function () {
    const colores = res.body.elementos.map((elemento) => elemento.vencimiento.semaforo);
    expect([...new Set(colores)]).to.eql(["ROJO"]);
  });
}

docs {
  HU-08. Filtros opcionales: semaforo, estado, tipo e idArea. Las vencidas salen primero.
  El color depende del día en que se corra; «Registrar un reclamo vital» garantiza al menos una en rojo.
}
