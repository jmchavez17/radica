xCell><mxCell id="e38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7143;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="Sí" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="No" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="335"/><mxPoint x="35" y="1178"/></Array></mxGeometry></mxCell><mxCell id="e46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="&lt;b&gt;Borrador de respuesta.&lt;/b&gt; Sigue el mismo camino por el puerto RedactorRespuesta. Si la IA falla, se usa la plantilla del tipo de PQRS. Ningún borrador cuenta como respuesta sin aprobación humana (HU-11)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFBEA;strokeColor=#D6B656;align=left;spacing=8;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="775" width="190" height="140" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Privacidad y seguridad.&lt;/b&gt; El proveedor solo recibe texto enmascarado, con un plan que no usa los datos para entrenar. La clave de API vive en el servidor. El texto del peticionario va delimitado como dato, no como instrucción, y la salida se valida contra un esquema con valores cerrados." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFBEA;strokeColor=#D6B656;align=left;spacing=8;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="935" width="190" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>