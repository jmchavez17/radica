              "nivelRiesgo": "SIMPLE",
              "origen": "REGLAS",
              "requiereRevision": false,
              "tipo": "RECLAMO"
            },
            "estado": "REGISTRADA",
            "estadoIa": "PENDIENTE",
            "id": 1287,
            "posiblesDuplicados": [],
            "radicado": "RAD-2026-001287",
            "vencimiento": {
              "fecha": "2026-11-02T16:00:00-05:00",
              "horasRestantes": 70.0,
              "regla": "Reclamo en salud, riesgo simple: 72 horas corridas",
              "semaforo": "VERDE"
            }
          }
        ]
      },
      "PqrsDetalle": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "radicado": {
            "type": "string",
            "title": "Radicado"
