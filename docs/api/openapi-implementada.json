{
  "openapi": "3.1.0",
  "info": {
    "title": "Radica API",
    "description": "\nAPI del asistente de gestión de PQRS Radica (Entrega 3). Implementa 6 de las\n13 operaciones del contrato `docs/api/radica-api-v0.1.yaml` más `GET /health`.\nLa clasificación con IA la hace en segundo plano el trabajador (`radica-trabajador`).\n\n- JSON en camelCase; fechas ISO 8601 con zona horaria (America/Bogota, -05:00).\n- Errores en Problem Details (RFC 9457), `application/problem+json`. La\n  validación responde 400.\n- Sin autenticación en esta entrega: las acciones se atribuyen al usuario\n  semilla «Funcionario Sintético» (contexto.md 4.12).\n- Todos los datos son sintéticos. Ninguna respuesta lleva datos del peticionario.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/pqrs": {
      "post": {
        "tags": [
          "PQRS"
        ],
        "summary": "Registrar una PQRS (HU-01)",
        "description": "Valida y guarda la PQRS, asigna el radicado, aplica la clasificación provisional por reglas, calcula el vencimiento y deja la clasificación con IA en PENDIENTE. No espera a la IA. Rechaza una fecha de radicación posterior al momento del registro.",
        "operationId": "registrarPqrs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PqrsNueva"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PQRS registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PqrsCreada"
                }
              }
            }
          },
          "400": {
            "description": "Datos faltantes o con formato inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                },
                "example": {
                  "type": "https://radica.local/problemas/validacion",
                  "title": "Datos inválidos",
                  "status": 400,
                  "detail": "La solicitud tiene 2 errores de validación.",
                  "instance": "/api/v1/pqrs",
                  "errores": [
                    {
                      "campo": "texto",
                      "mensaje": "El texto es obligatorio."
                    },
                    {
                      "campo": "fechaRadicacion",
                      "mensaje": "Debe ser una fecha ISO 8601 con zona horaria."
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "PQRS"
        ],
        "summary": "Bandeja de PQRS con semáforo (HU-08)",
        "description": "Ordenada por vencimiento ascendente: las vencidas quedan primero.",
        "operationId": "listarPqrs",
        "parameters": [
          {
            "name": "semaforo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Semaforo"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Semaforo"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EstadoPqrs"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "name": "idArea",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Área sugerida vigente.",
              "title": "Idarea"
            },
            "description": "Área sugerida vigente."
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TipoPqrs"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tipo"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Pagina"
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Tamano"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de PQRS ordenadas por vencimiento.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaPqrs"
                }
              }
            }
          },
          "400": {
            "description": "Datos faltantes o con formato inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pqrs/{id}": {
      "get": {
        "tags": [
          "PQRS"
        ],
        "summary": "Consultar una PQRS con su clasificación vigente y su vencimiento (HU-04, HU-07)",
        "description": "Solo se muestra el texto enmascarado.",
        "operationId": "consultarPqrs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Id interno de la PQRS.",
              "title": "Id"
            },
            "description": "Id interno de la PQRS."
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la PQRS con el texto enmascarado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PqrsDetalle"
                }
              }
            }
          },
          "400": {
            "description": "Datos faltantes o con formato inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "La PQRS no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pqrs/{id}/clasificaciones": {
      "post": {
        "tags": [
          "Clasificación"
        ],
        "summary": "Solicitar de nuevo la clasificación con IA (reintento manual)",
        "description": "Deja la PQRS con estadoIa PENDIENTE para que el trabajador la clasifique en segundo plano. No espera a la IA.",
        "operationId": "solicitarClasificacionIa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Id interno de la PQRS.",
              "title": "Id"
            },
            "description": "Id interno de la PQRS."
          }
        ],
        "responses": {
          "202": {
            "description": "Solicitud encolada; la PQRS queda en estado de IA PENDIENTE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClasificacionSolicitada"
                }
              }
            }
          },
          "400": {
            "description": "Datos faltantes o con formato inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "La PQRS no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "409": {
            "description": "La PQRS ya está PENDIENTE de clasificación o está RESPONDIDA o CERRADA.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pqrs/{id}/historial": {
      "get": {
        "tags": [
          "Tablero"
        ],
        "summary": "Historial completo de una PQRS (HU-13)",
        "description": "Eventos de auditoría en orden cronológico. Los eventos de una sugerencia de la IA (CLASIFICAR_IA y SUGERENCIA_IA_NO_APLICADA) traen el modelo y la versión de instrucciones; los demás los traen nulos.",
        "operationId": "consultarHistorial",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Id interno de la PQRS.",
              "title": "Id"
            },
            "description": "Id interno de la PQRS."
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos de auditoría de la PQRS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Historial"
                }
              }
            }
          },
          "400": {
            "description": "Datos faltantes o con formato inválido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "La PQRS no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/configuracion/terminos": {
      "get": {
        "tags": [
          "Configuración"
        ],
        "summary": "Tabla de términos vigente",
        "operationId": "listarTerminos",
        "responses": {
          "200": {
            "description": "Términos vigentes hoy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TablaTerminos"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Técnico"
        ],
        "summary": "Estado de la API y de la base de datos",
        "operationId": "salud_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
