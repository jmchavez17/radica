meta {
  name: Registrar un reclamo vital
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/pqrs
  body: json
  auth: none
}

body:json {
  {
    "canal": "DIME",
    "sede": "Sede clínica",
    "fechaRadicacion": "2026-10-30T16:00:00-05:00",
    "texto": "Mi papá tiene dificultad para respirar desde anoche y nadie le da respuesta.",
    "pacienteMenorDeEdad": false,
    "peticionario": {
      "tipoDocumento": "CC",
      "numeroDocumento": "1000000002",
      "nombre": "Usuario Sintético Dos",
      "telefono": "3000000002",
      "correo": "usuario2@ejemplo.com"
    }
  }
}

assert {
  res.status: eq 201
  res.body.clasificacionProvisional.tipo: eq RECLAMO
  res.body.clasificacionProvisional.nivelRiesgo: eq VITAL
  res.body.vencimiento.fecha: eq 2026-10-31T16:00:00-05:00
  res.body.vencimiento.regla: eq Reclamo en salud, riesgo vital: 24 horas corridas
}

docs {
  Palabra de alarma: «dificultad para respirar». 24 horas corridas desde la radicación.
  La fecha es fija y ya venció: garantiza al menos una PQRS en rojo para «Bandeja en rojo».
}
