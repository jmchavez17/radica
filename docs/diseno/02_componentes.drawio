<mxfile host="Electron" agent="Radica" version="24.0.0"><diagram id="Componentes_(hexagonal)" name="Componentes (hexagonal)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:21px"&gt;Radica · Diagrama de componentes (arquitectura hexagonal: puertos y adaptadores)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#555"&gt;Núcleo organizado como Clean Architecture (dominio y casos de uso). Entrega 2 · Módulo 2 · 27 de octubre de 2026&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1300" height="52" as="geometry"/></mxCell><mxCell id="c2" value="ADAPTADORES DE ENTRADA" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F7F7F7;strokeColor=#9E9E9E;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#333333;container=1;collapsible=0;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="270" height="820" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Aplicación web&lt;/b&gt; &lt;span style="color:#555"&gt;[SPA · React + TypeScript]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Bandeja con semáforo, registro, revisión de la clasificación, borradores, aprobación y tablero&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c2"><mxGeometry x="15" y="38" width="240" height="92" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;API REST&lt;/b&gt; &lt;span style="color:#555"&gt;[FastAPI · HTTPS · JSON]&lt;/span&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#6C8EBF;verticalAlign=top;fontSize=12;container=1;collapsible=0;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="c2"><mxGeometry x="15" y="170" width="240" height="470" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Autenticación y roles&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;JWT; valida el token y el rol en cada solicitud&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="32" width="220" height="64" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;PqrsController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST y GET /pqrs · PATCH /pqrs/{id}/clasificacion · POST /pqrs/{id}/prorroga&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="104" width="220" height="64" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;ImportacionController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /importaciones (CSV)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="176" width="220" height="64" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;RespuestaController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /pqrs/{id}/borradores · POST /borradores/{id}/aprobacion&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="248" width="220" height="64" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;TableroController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /tablero · /reportes/semaforo · /pqrs/{id}/historial&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="320" width="220" height="64" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;ConfiguracionController&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;términos, festivos, áreas y atributos (coordinación)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c4"><mxGeometry x="10" y="392" width="220" height="64" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Tareas programadas&lt;/b&gt; &lt;span style="color:#555"&gt;[APScheduler]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cada 15 min: semáforo, recordatorios y reintentos de IA&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c2"><mxGeometry x="15" y="658" width="240" height="70" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Trabajador de clasificación&lt;/b&gt; &lt;span style="color:#555"&gt;[proceso en segundo plano]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Atiende las PQRS en estado PENDIENTE_IA&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c2"><mxGeometry x="15" y="738" width="240" height="70" as="geometry"/></mxCell><mxCell id="e13" value='&lt;span style="font-size:11px"&gt;HTTPS · JSON&lt;/span&gt;' style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c14" value="APLICACIÓN · casos de uso (puertos de entrada)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F7F7F7;strokeColor=#9E9E9E;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#333333;container=1;collapsible=0;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="340" height="690" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;RegistrarPqrs&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-01)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;valida, radica, clasifica por reglas, plazo provisional y posibles duplicados&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="36" width="310" height="48" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;ImportarPqrsCsv&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-02)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;lote con filas rechazadas y su motivo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="90" width="310" height="48" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;ClasificarPqrs&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-03, 04, 05)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;enmascara, llama al clasificador y aplica la política de riesgo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="144" width="310" height="48" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;CorregirClasificacion&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-06)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;recalcula el plazo; motivo obligatorio si baja el riesgo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="198" width="310" height="48" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;AsignarArea&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-09)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;por reglas o manual con motivo; notifica al área&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="252" width="310" height="48" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;RegistrarProrroga&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-07)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;antes del vencimiento y hasta el doble del plazo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="306" width="310" height="48" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;EvaluarVencimientos&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-08)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;semáforo, alertas y recordatorios&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="360" width="310" height="48" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;GenerarBorrador&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-10)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;solo con los datos dados; marca [COMPLETAR]&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="414" width="310" height="48" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;AprobarRespuesta&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-11)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;sin aprobación no hay respuesta&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="468" width="310" height="48" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;ConsultarTablero&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-12)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;vencimientos, carga, temas y reporte CSV&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="522" width="310" height="48" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;ConsultarHistorial&lt;/b&gt; &lt;span style="color:#555"&gt;(HU-13)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;quién cambió qué, cuándo y con qué modelo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="576" width="310" height="48" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;AdministrarConfiguracion&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;términos, festivos, áreas y atributos&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c14"><mxGeometry x="15" y="630" width="310" height="48" as="geometry"/></mxCell><mxCell id="c27" value="DOMINIO · reglas puras, sin dependencias externas" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F7F7F7;strokeColor=#9E9E9E;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#333333;container=1;collapsible=0;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="790" width="340" height="255" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;Pqrs · Clasificacion · Borrador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;entidades y estados del ciclo de vida&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="12" y="32" width="154" height="66" as="geometry"/></mxCell><mxCell id="c29" value='&lt;b&gt;CalculadoraDePlazos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;días hábiles con festivos, horas corridas, prórroga hasta el doble&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="174" y="32" width="154" height="66" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;PoliticaDeRiesgo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;nivel = máximo(reglas, IA); solo una persona lo baja&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="12" y="104" width="154" height="66" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;Semaforo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;tiempo restante → verde, amarillo o rojo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="174" y="104" width="154" height="66" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b&gt;ReglaDeAsignacion&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;atributo → área; confianza baja → revisión&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="12" y="176" width="154" height="66" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;DetectorDeDuplicados&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;mismo peticionario y texto similar en 30 días&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="c27"><mxGeometry x="174" y="176" width="154" height="66" as="geometry"/></mxCell><mxCell id="c34" value="PUERTOS DE SALIDA (interfaces)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F7F7F7;strokeColor=#9E9E9E;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#333333;container=1;collapsible=0;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="230" height="890" as="geometry"/></mxCell><mxCell id="c35" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;PqrsRepository&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;guardar, buscar, listar por semáforo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="40" width="200" height="50" as="geometry"/></mxCell><mxCell id="c36" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;AuditoriaRepository&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;historial y llamadas a IA (solo inserción)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="100" width="200" height="50" as="geometry"/></mxCell><mxCell id="c37" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;ConfiguracionRepository&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;términos, festivos, áreas, atributos&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="160" width="200" height="50" as="geometry"/></mxCell><mxCell id="c38" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;ClasificadorPqrs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;clasificar(solicitud) → resultado&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="333" width="200" height="50" as="geometry"/></mxCell><mxCell id="c39" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;RedactorRespuesta&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;redactar(solicitud) → borrador&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="450" width="200" height="50" as="geometry"/></mxCell><mxCell id="c40" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Enmascarador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;enmascarar(texto) → texto y verificación&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="620" width="200" height="50" as="geometry"/></mxCell><mxCell id="c41" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notificador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;enviar(notificación)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="720" width="200" height="50" as="geometry"/></mxCell><mxCell id="c42" value='&lt;span style="font-size:11px"&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;ArchivoTabular&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;leer y escribir CSV&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="c34"><mxGeometry x="15" y="805" width="200" height="50" as="geometry"/></mxCell><mxCell id="c43" value="ADAPTADORES DE SALIDA" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F7F7F7;strokeColor=#9E9E9E;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#333333;container=1;collapsible=0;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="300" height="890" as="geometry"/></mxCell><mxCell id="c44" value='&lt;b&gt;RepositoriosPostgreSQL&lt;/b&gt; &lt;span style="color:#555"&gt;[SQLAlchemy]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;implementa los tres repositorios; la auditoría no admite UPDATE ni DELETE&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="40" width="270" height="170" as="geometry"/></mxCell><mxCell id="c45" value='&lt;b&gt;ClasificadorPalabrasClave&lt;/b&gt; &lt;span style="color:#555"&gt;[local, sin red]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;línea base, respaldo y clasificación provisional&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="260" width="270" height="56" as="geometry"/></mxCell><mxCell id="c46" value='&lt;b&gt;AdaptadorClaude&lt;/b&gt; &lt;span style="color:#555"&gt;[SDK de Anthropic]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Haiku 5.5; timeout, reintentos y validación del JSON&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="330" width="270" height="56" as="geometry"/></mxCell><mxCell id="c47" value='&lt;b&gt;AdaptadorGemini&lt;/b&gt; &lt;span style="color:#555"&gt;[SDK de Google]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;alterno; mismo contrato&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="400" width="270" height="56" as="geometry"/></mxCell><mxCell id="c48" value='&lt;b&gt;RedactorPlantillas&lt;/b&gt; &lt;span style="color:#555"&gt;[local]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;plantilla por tipo si la IA no está disponible&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="470" width="270" height="56" as="geometry"/></mxCell><mxCell id="c49" value='&lt;b&gt;EnmascaradorReglas&lt;/b&gt; &lt;span style="color:#555"&gt;[regex + NER local]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;cédula, teléfono, correo, n.º de historia; nombres con NER local (PB-05)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="610" width="270" height="70" as="geometry"/></mxCell><mxCell id="c50" value='&lt;b&gt;NotificadorSMTP&lt;/b&gt; &lt;span style="color:#555"&gt;[smtplib]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;correo a áreas y coordinación&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="715" width="270" height="60" as="geometry"/></mxCell><mxCell id="c51" value='&lt;b&gt;AdaptadorCSV&lt;/b&gt; &lt;span style="color:#555"&gt;[csv · UTF-8]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;importación con rechazos y exportación semaforizada&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;verticalAlign=middle;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="c43"><mxGeometry x="15" y="800" width="270" height="60" as="geometry"/></mxCell><mxCell id="c52" value='&lt;b style="font-size:13px;color:#333"&gt;SISTEMAS EXTERNOS&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="72" width="240" height="24" as="geometry"/></mxCell><mxCell id="c53" value='&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PQRS, configuración e historial; cifrado en reposo&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="122" width="240" height="140" as="geometry"/></mxCell><mxCell id="c54" value='&lt;b&gt;API de Anthropic&lt;/b&gt; &lt;span style="color:#555"&gt