<mxfile host="Electron" agent="Radica" version="24.0.0"><diagram id="Flujo_de_integración_con_IA" name="Flujo de integración con IA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b style="font-size:21px"&gt;Radica · Flujo de interacción entre la aplicación y el proveedor de IA (clasificación)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#555"&gt;Entrega 2 · Módulo 2 · 27 de octubre de 2026 · el modelo no ejecuta acciones ni decide plazos&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1360" height="52" as="geometry"/></mxCell><mxCell id="c2" value="Funcionario · interfaz web" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;collapsible=0;container=0;strokeColor=#9E9E9E;fontFamily=Helvetica;fillColor=#DAE8FC;swimlaneFillColor=#FAFCFF;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="220" height="1250" as="geometry"/></mxCell><mxCell id="c3" value="Radica · API, casos de uso y dominio" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;collapsible=0;container=0;strokeColor=#9E9E9E;fontFamily=Helvetica;fillColor=#D5E8D4;swimlaneFillColor=#FBFDFA;" vertex="1" parent="1"><mxGeometry x="240" y="66" width="480" height="1250" as="geometry"/></mxCell><mxCell id="c4" value="AdaptadorClaude&lt;br&gt;(implementa ClasificadorPqrs)" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;collapsible=0;container=0;strokeColor=#9E9E9E;fontFamily=Helvetica;fillColor=#E1D5E7;swimlaneFillColor=#FDFBFE;" vertex="1" parent="1"><mxGeometry x="720" y="66" width="440" height="1250" as="geometry"/></mxCell><mxCell id="c5" value="Proveedor de IA&lt;br&gt;(API de Anthropic)" style="swimlane;startSize=40;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;collapsible=0;container=0;strokeColor=#9E9E9E;fontFamily=Helvetica;fillColor=#F5F5F5;swimlaneFillColor=#FCFCFC;" vertex="1" parent="1"><mxGeometry x="1160" y="66" width="220" height="1250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Inicio&lt;/b&gt;: PQRS registrada con clasificación provisional por reglas (estado_ia = PENDIENTE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="280" height="60" as="geometry"/></mxCell><mxCell id="c7" value="El trabajador toma la PQRS y &lt;b&gt;enmascara los datos personales&lt;/b&gt; (reglas y NER local)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="205" width="280" height="60" as="geometry"/></mxCell><mxCell id="c8" value="¿Enmascaramiento verificado?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="285" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Arma la solicitud: instrucciones versionadas, catálogos (tipos, atributos, áreas) y texto enmascarado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="410" width="280" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Sin IA&lt;/b&gt;: se conserva la clasificación por reglas; estado_ia = FALLIDA y REQUIERE_REVISION; reintento programado cada 10 min (máx. 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="150" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Política de riesgo&lt;/b&gt;: nivel = máximo(reglas, IA); confianza baja → REQUIERE_REVISION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="830" width="280" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Recalcula el vencimiento, asigna el área y registra la auditoría (modelo y versión de instrucciones)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="925" width="280" height="70" as="geometry"/></mxCell><mxCell id="c13" value="¿Riesgo vital?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="1020" width="200" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Notifica la asignación al área (correo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="1130" width="280" height="56" as="geometry"/></mxCell><mxCell id="c15" value="¿Circuito abierto?&lt;br&gt;(5 fallas seguidas)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="245" height="90" as="geometry"/></mxCell><mxCell id="c16" value="Envía la solicitud por HTTPS: timeout de 15 s, hasta 2 reintentos (2 s y 8 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="245" height="70" as="geometry"/></mxCell><mxCell id="c17" value="¿Respuesta a tiempo y con JSON válido?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="690" width="245" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Error controlado&lt;/b&gt;: ProveedorNoDisponible o SalidaInvalida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="735" y="690" width="150" height="90" as="geometry"/></mxCell><mxCell id="c19" value="Normaliza a los valores del dominio y registra tokens, costo y latencia" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="845" width="245" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Modelo de lenguaje&lt;/b&gt;: recibe texto enmascarado e instrucciones; clasifica, resume y devuelve JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="575" width="190" height="100" as="geometry"/></mxCell><mxCell id="c21" value="Recibe la PQRS para &lt;b&gt;clasificación manual&lt;/b&gt;; no hubo llamada externa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="180" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Alerta inmediata&lt;/b&gt; en la bandeja y correo a coordinación; plazo de 24 h (8 h si el paciente es menor)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1015" width="180" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Revisa, confirma o corrige&lt;/b&gt; (motivo obligatorio si baja el riesgo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1130" width="180" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Fin&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="1240" width="110" height="40" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="Sí" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e28" value="No" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.4;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c21"><mxGeometry rela